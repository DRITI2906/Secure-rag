# Copy to `.env` for LOCAL dev only. NEVER commit `.env`.
# In Azure, do NOT use a .env file — secrets come from Key Vault via Managed Identity,
# and non-secret config comes from Container App env vars.

# --- LLM (Groq) ---
# LOCAL ONLY: paste your Groq key here for local dev.
# In Azure this value is fetched from Key Vault at runtime, never set as plaintext.
GROQ_API_KEY=

GROQ_MODEL=llama-3.3-70b-versatile
# Llama Prompt Guard 2 — small specialized prompt-injection classifier; returns p(injection).
GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
PROMPT_GUARD_THRESHOLD=0.5

# --- Embeddings (local, no egress) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Retrieval ---
TOP_K=4
# Minimum cosine similarity for a chunk to count as "relevant".
# Below this for all chunks => refuse as out-of-scope.
# Tuned empirically on the arXiv corpus: on-topic queries score 0.77+, off-topic 0.48-0.70.
MIN_RELEVANCE_SCORE=0.72

# --- Guardrails / limits ---
MAX_QUERY_CHARS=2000
MAX_OUTPUT_TOKENS=512
RATE_LIMIT_PER_MINUTE=10

# --- API auth (local dev) ---
# In Azure prefer Easy Auth / Entra ID; this static key is a local fallback.
API_KEY=

# --- Azure (set in cloud; blank locally) ---
KEY_VAULT_URI=
KEY_VAULT_SECRET_NAME=groq-api-key
BLOB_ACCOUNT_URL=
BLOB_CONTAINER=rag-index
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- App ---
CORPUS_DESCRIPTION="the provided document set"
LOG_LEVEL=INFO
